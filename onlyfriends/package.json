{
  "name": "onlyfriends",
  "version": "0.1.1",
  "private": true,
  "description": "Minimalist, distraction-free Instagram experience for Firefox — friends-only feed, mindful usage.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "start": "node scripts/serve.mjs",
    "start:web": "npm run package && node scripts/serve.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.promises.rm('dist',{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
